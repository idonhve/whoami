# 复制本文件为 .env 并填好各值（.env 已被 .gitignore 忽略，不会进 git）
# 敏感密钥（数据库口令、JWT 密钥、GitHub PAT）只存在于 .env，不下发前端。

# 数据库（MySQL 8 容器与应用共用这组账号口令）
DB_USER=whoami
DB_PASSWORD=change-me-to-a-strong-password

# JWT 签名密钥：至少 32 字符，生产环境务必换成随机串
# 生成示例（PowerShell）：
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | ForEach-Object {[char]$_})
JWT_SECRET=please-generate-a-random-secret-at-least-32-chars

# GitHub 同步（Spec 04 使用，现在可留空）
# PAT 只勾选只读公开仓库权限（public_repo），只注入后端，不下发前端
GITHUB_TOKEN=
GITHUB_OWNER=

# 时区
TZ=Asia/Shanghai

# 以下为可选端口覆盖（不填用默认值）
# HTTP_PORT=80        # nginx 对外端口
# BACKEND_PORT=8080   # 后端直连端口（调试用）
# DB_PORT=3306        # MySQL 对外端口（调试用）
